    "settings.brew.analyticsDesc.beforeCommand": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew sends anonymous install analytics to formulae.brew.sh by default. This toggle flips Homebrew's setting (the same as running "
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew по умолчанию отправляет анонимную аналитику установок на formulae.brew.sh. Этот переключатель меняет настройку Homebrew (то же, что выполнить "
          }
        }
      }
    },
