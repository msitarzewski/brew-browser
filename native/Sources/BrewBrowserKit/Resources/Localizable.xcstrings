    "enrichment.fetchLatest.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "brew-browser ships with built-in AI categories and descriptions. When enabled, it checks for newer first-party enrichment data and fetches a package description when you open the package detail. Only the viewed package name is sent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "brew-browser поставляется со встроенными ИИ-категориями и описаниями. Если включено, приложение проверяет наличие более свежих данных проекта и получает описание пакета, когда вы открываете его карточку. Отправляется только имя просматриваемого пакета."
          }
        }
