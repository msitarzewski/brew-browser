    "settings.trendingHistory.hint.beforeHost": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, brew-browser fetches per-package historical install trends from "
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если включено, brew-browser загружает историческую динамику установок по пакетам с "
          }
        }
      }
    },
    "settings.trendingHistory.hint.afterHost": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " to power per-row sparklines on the Trending tab and a chart on each package's detail panel. Only the package name you're viewing is sent (one HTTP GET per package); no IP is logged at the server, no cookies, no fingerprinting. The endpoint is operated by the brew-browser project - a distinct trust boundary from the always-on Homebrew analytics paths above."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": " для мини-графиков в строках вкладки «Тренды» и графика в карточке пакета. Отправляется только имя просматриваемого пакета (один HTTP GET на пакет); сервер не логирует IP, не использует файлы cookie и не собирает цифровой отпечаток. Этот эндпоинт поддерживает проект brew-browser — это отдельная зона доверия от постоянно доступных выше путей аналитики Homebrew."
          }
        }
      }
    },
    "settings.trendingHistory.offline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline Mode is on - this toggle is locked off. Turn Offline Mode off above to enable history fetching."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Офлайн-режим включён — переключатель заблокирован. Отключите офлайн-режим выше, чтобы разрешить загрузку истории."
          }
        }
      }
    },
    "settings.about.zeroTelemetryBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "brew-browser does not collect telemetry. It does not phone home. It does not have user accounts. Every outbound network request is documented in Settings -> Network and the README, and only fires when you take an action that requires it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "brew-browser не собирает телеметрию, не обращается к своим серверам без необходимости и не использует учётные записи. Все исходящие сетевые запросы описаны в «Настройки → Сеть» и README и выполняются только для действий, которым они нужны."
          }
        }
      }
    },
