      }
    },
    "trending.fetchHistory.help": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "When on, brew-browser fetches per-package historical install trends from brew-browser.zerologic.com/trending-history/* to power sparklines on Trending and each package's detail panel. Only the package name you are viewing is sent." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Если включено, brew-browser загружает историю установок по пакетам с brew-browser.zerologic.com/trending-history/* для спарклайнов в Трендах и карточке пакета. Отправляется только имя открытого пакета." } }
      }
    },
    "updates.autoCheck": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Automatically check for updates" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Автоматически проверять обновления" } }
      }
    },
    "updates.autoCheck.help": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "When on, brew-browser checks for a newer version once a day and shows a notice in the title bar if one is available. Suspended while Offline Mode is on." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Если включено, brew-browser раз в день проверяет новую версию и показывает уведомление в заголовке окна. В офлайн-режиме проверка приостанавливается." } }
      }
    },
    "updates.available": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Update available" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Доступно обновление" } }
      }
    },
    "updates.available.help": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "A newer version of brew-browser is available — click to update" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Доступна новая версия brew-browser — нажмите, чтобы обновить" } }
      }
    },
    "updates.channel": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Update channel" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Канал обновлений" } }
      }
    },
    "updates.channel.label": {
      "localizations": {
