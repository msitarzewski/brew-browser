          "stringUnit": {
            "state": "translated",
            "value": " для опытных пользователей."
          }
        }
      }
    },
    "settings.brew.greedyDesc.beforeFlag": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds "
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет "
          }
        }
      }
    },
    "settings.brew.greedyDesc.between": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " to "
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": " к "
          }
        }
      }
    },
    "settings.brew.greedyDesc.afterCommand": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " so casks that update themselves (like Chrome) are upgraded too. Off by default - greedy can churn apps that manage their own updates."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ", чтобы обновлялись и cask-пакеты с собственным механизмом обновления (например, Chrome). По умолчанию выключено: режим --greedy может лишний раз переустанавливать такие приложения."
          }
        }
      }
    },
    "settings.brew.autoremoveDesc.beforeCommand": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs "
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускает "
          }
        }
      }
    },
    "settings.brew.autoremoveDesc.afterCommand": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " to uninstall formulae that were installed only as dependencies and are no longer needed by anything."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ", чтобы удалить формулы, установленные только как зависимости и больше не нужные ни одному пакету."
          }
        }
      }
    },
    "settings.brew.autoremoveConfirm.beforeCommand": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This runs "
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будет выполнено "
          }
        }
      }
    },
    "settings.brew.autoremoveConfirm.afterCommand": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": ", which uninstalls formulae that were installed only as dependencies and are no longer required by anything else."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": команда удалит формулы, установленные только как зависимости и больше не используемые другими пакетами."
          }
        }
      }
    },
    "settings.liveEnrichment.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live category & description updates"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свежие категории и описания"
          }
        }
      }
    },
    "settings.liveEnrichment.hint.beforeHost": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "brew-browser ships with a built-in set of AI categories and descriptions. When on, it refreshes them from "
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "brew-browser поставляется со встроенными ИИ-категориями и описаниями. Если включено, приложение обновляет их с "
          }
        }
      }
    },
    "settings.liveEnrichment.hint.afterHost": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": ": a tiny version check on refresh, the full category list when it's newer, and a per-package description when you open that package's detail. Only the package name you're viewing is sent (one HTTP GET); no IP is logged at the server, no cookies. Same first-party host as Enhanced Trending - a distinct trust boundary from the always-on Homebrew paths. Requires AI Features on."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ": при обновлении проверяет версию, загружает полный список категорий, если он новее, и получает описание пакета, когда вы открываете его карточку. Отправляется только имя просматриваемого пакета (один HTTP GET); сервер не логирует IP и не использует файлы cookie. Это собственный эндпоинт проекта brew-browser, отдельная зона доверия от постоянно доступных путей Homebrew. Требует включить функции ИИ."
          }
        }
      }
    },
    "settings.liveEnrichment.offline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline Mode is on - this toggle is locked off. Turn Offline Mode off above to enable live updates."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Офлайн-режим включён — переключатель заблокирован. Отключите офлайн-режим выше, чтобы разрешить обновление категорий и описаний."
          }
        }
      }
    },
    "settings.trendingHistory.title": {
      "localizations": {
        "en": {
