    "activity.keepJobs.format": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Keep last %d completed jobs" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Хранить последние завершённые задачи: %d" } }
      }
    },
    "activity.limits.help": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "These limits apply to future job persistence. Existing retained data is not trimmed retroactively." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Эти ограничения применяются к будущему сохранению задач. Уже сохранённые данные задним числом не обрезаются." } }
      }
    },
    "activity.linesPerJob.format": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Lines per job: %d" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Строк на задачу: %d" } }
      }
    },
    "activity.notifyOnCompletion": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Notify when brew tasks finish" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Уведомлять о завершении задач brew" } }
      }
    },
    "activity.notifyOnCompletion.help": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Posts a macOS notification when an install, upgrade, or other brew task finishes while brew-browser is not the front app. When it is in front, the Activity drawer shows progress instead. Turning this on asks macOS for notification permission." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Показывает уведомление macOS, когда установка, обновление или другая задача brew завершается не в активном окне brew-browser. Если приложение на переднем плане, прогресс виден в журнале активности. При включении macOS запросит разрешение на уведомления." } }
      }
    },
    "chrome.donate.help": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Support brew-browser via GitHub Sponsors" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Поддержать brew-browser через GitHub Sponsors" } }
      }
    },
    "chrome.donate.menu": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Sponsor Brew Browser..." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Поддержать Brew Browser..." } }
      }
    },
    "date.today": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "today" } },
        "ru": { "stringUnit": { "state": "translated", "value": "сегодня" } }
      }
    },
    "enrichment.fetchLatest": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Fetch latest categories & descriptions" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Загружать свежие категории и описания" } }
      }
    },
    "enrichment.fetchLatest.help": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "brew-browser ships with built-in AI categories and descriptions. When on, it refreshes them from brew-browser.zerologic.com/enrichment/*. Only the package name you are viewing is sent. Requires AI features on." } },
        "ru": { "stringUnit": { "state": "translated", "value": "brew-browser поставляется со встроенными AI-категориями и описаниями. Если включено, приложение обновляет их с brew-browser.zerologic.com/enrichment/*. Отправляется только имя открытого пакета. Требует включённых AI-функций." } }
      }
    },
    "filter.all": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "All" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Все" } }
