          }
        }
      }
    },
    "settings.brew.confirmationsDesc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Destructive actions (Uninstall, Zap, Delete Brewfile) ask before proceeding. Power users can turn this off once they're sure."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед необратимыми действиями (удаление пакета, zap-очистка, удаление Brewfile) приложение запрашивает подтверждение. Опытные пользователи могут отключить это, когда будут уверены."
          }
        }
      }
    },
    "settings.brew.advancedDesc.beforeCommand": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extra "
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дополнительные параметры "
