    "discover.subgroupNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "grouped by overlapping category"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "сгруппировано по пересекающимся категориям"
          }
        }
      }
    },
    "discover.subgroupsBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew has no official sub-category data, so this is a co-occurrence grouping: within \"{category}\", packages are bucketed by the other categories they also belong to. A package with several overlapping categories appears in each bucket. \"General {category}\" holds packages tagged only \"{category}\" - it's often the largest group, and this is a grouping aid, not a strict taxonomy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У Homebrew нет официальных подкатегорий, поэтому это группировка по совместной встречаемости: внутри «{category}» пакеты раскладываются по другим категориям, к которым они тоже относятся. Пакет с несколькими пересекающимися категориями попадает в каждую такую группу. «Общее: {category}» содержит пакеты, отмеченные только категорией «{category}». Это подсказка для навигации, а не строгая таксономия."
          }
        }
      }
    },
    "discover.subgroupsLabel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About sub-categories"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О подкатегориях"
          }
        }
      }
    },
