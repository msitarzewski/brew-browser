    "security.brewVulnsInstalled": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "brew vulns is installed." } },
        "ru": { "stringUnit": { "state": "translated", "value": "brew vulns установлен." } }
      }
    },
    "security.brewVulnsMissing.help": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The brew-vulns subcommand is not installed. Install it now? This runs `brew install homebrew/brew-vulns/brew-vulns`." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Подкоманда brew-vulns не установлена. Установить сейчас? Будет выполнено `brew install homebrew/brew-vulns/brew-vulns`." } }
      }
    },
    "security.installBrewVulns": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Install brew-vulns" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Установить brew-vulns" } }
      }
    },
    "security.offlineSuppressed": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Offline Mode is on — scanning is suppressed even if this is on." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Офлайн-режим включён: сканирование подавлено, даже если этот переключатель включён." } }
      }
    },
    "security.scanInstalled": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Scan installed packages for known vulnerabilities" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Проверять установленные пакеты на известные уязвимости" } }
      }
    },
    "security.scanInstalled.help": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Opt-in, off by default. Shells out to the official `brew vulns` subcommand, which queries OSV.dev for known vulnerabilities in your installed formulae. If signed in to GitHub, GHSA IDs are enriched from api.github.com. No package list leaves your machine except the queries brew vulns makes." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Опционально и по умолчанию выключено. Запускает официальную подкоманду `brew vulns`, которая запрашивает OSV.dev по известным уязвимостям установленных формул. При входе в GitHub GHSA ID дополняются данными api.github.com. Список пакетов не покидает компьютер, кроме запросов, которые выполняет brew vulns." } }
      }
    },
    "security.viewVulnerablePackages": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "View vulnerable packages ->" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Показать уязвимые пакеты ->" } }
      }
    },
    "services.alreadyRunning": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Already running" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Уже запущена" } }
      }
    },
    "services.empty.body": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Formulae like postgresql, redis, or nginx register background services you can start and stop here." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Формулы вроде postgresql, redis или nginx регистрируют фоновые службы, которые можно запускать и останавливать здесь." } }
      }
    },
    "services.empty.title": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "No background services" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Фоновых служб нет" } }
      }
    },
    "services.loadFailed": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Couldn't load services" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Не удалось загрузить службы" } }
      }
    },
    "services.loading": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Loading brew services..." } },
