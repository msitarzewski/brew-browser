    "github.connectedAs.format": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "GitHub: connected as @%@" } },
        "ru": { "stringUnit": { "state": "translated", "value": "GitHub: подключено как @%@" } }
      }
    },
    "github.deviceFlowInstructions.format": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Enter this code at %@ (opened in your browser). Waiting for authorization..." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Введите этот код на %@ (страница открыта в браузере). Ждём авторизацию..." } }
      }
    },
    "github.keychain.help": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Your token is stored in the macOS Keychain — never sent over IPC, written to disk, or logged. Sign-in is optional; minimum scopes are read:user, public_repo, and notifications." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Токен хранится в macOS Keychain: он не передаётся по IPC, не записывается на диск и не попадает в логи. Вход необязателен; минимальные scope: read:user, public_repo и notifications." } }
      }
    },
    "github.noInstalledHomepages": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "None of your installed packages have a GitHub homepage." } },
        "ru": { "stringUnit": { "state": "translated", "value": "У установленных пакетов нет GitHub homepage." } }
      }
    },
    "github.scopeIncomplete": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "GitHub: signed in — scope incomplete; open Settings to fix" } },
        "ru": { "stringUnit": { "state": "translated", "value": "GitHub: вход выполнен, но scope неполный; откройте Настройки, чтобы исправить" } }
      }
    },
    "github.signIn": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Sign in" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Вход" } }
      }
    },
    "github.signIn.help": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Opens GitHub's standard authorize flow in your browser. No password is entered into brew-browser. Required to Star, Watch, and file issues." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Открывает стандартную авторизацию GitHub в браузере. Пароль не вводится в brew-browser. Нужно для Star, Watch и создания issue." } }
      }
    },
    "github.signInWithGitHub": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Sign in with GitHub" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Войти через GitHub" } }
