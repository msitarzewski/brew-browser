        "ru": { "stringUnit": { "state": "translated", "value": "Остановить службу" } }
      }
    },
    "settings.appearance.aiFeatures": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "AI features" } },
        "ru": { "stringUnit": { "state": "translated", "value": "AI-функции" } }
      }
    },
    "settings.appearance.aiFeatures.help": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Shows extra metadata generated at build time: friendly names, descriptions, use-cases, similar packages, and category tags. Zero LLM calls are made from your machine — all enrichment is baked into the app. When off, only Homebrew's native metadata appears (categories are hidden)." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Показывает дополнительные метаданные, созданные на этапе сборки: понятные названия, описания, сценарии использования, похожие пакеты и категории. С вашего компьютера не выполняется ни одного LLM-запроса: все данные уже встроены в приложение. Если выключено, показываются только штатные метаданные Homebrew, а категории скрываются." } }
      }
    },
    "settings.appearance.defaultLanding": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Default landing" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Стартовый раздел" } }
      }
    },
    "settings.brew.advanced": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Advanced" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Дополнительно" } }
      }
    },
    "settings.brew.analytics": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Analytics" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Аналитика" } }
      }
    },
    "settings.brew.analytics.help": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Homebrew sends anonymous install analytics to formulae.brew.sh by default. This flips Homebrew's own setting (same as `brew analytics on`/`off`)." } },
        "ru": { "stringUnit": { "state": "translated", "value": "По умолчанию Homebrew отправляет анонимную аналитику установок на formulae.brew.sh. Этот переключатель меняет собственную настройку Homebrew, как `brew analytics on`/`off`." } }
      }
    },
    "settings.brew.autoremove": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Autoremove" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Удалить лишние зависимости" } }
      }
    },
    "settings.brew.autoremove.confirmMessage": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This runs `brew autoremove`, which uninstalls formulae that were installed only as dependencies and are no longer required by anything else." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Будет выполнено `brew autoremove`: команда удаляет формулы, установленные только как зависимости и больше никому не нужные." } }
      }
    },
    "settings.brew.autoremove.confirmTitle": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Remove unused dependencies?" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Удалить неиспользуемые зависимости?" } }
      }
    },
    "settings.brew.autoremove.help": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Runs `brew autoremove` to uninstall formulae that were installed only as dependencies and are no longer needed by anything." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Запускает `brew autoremove`, чтобы удалить формулы, установленные только как зависимости и больше ничему не нужные." } }
      }
    },
    "settings.brew.autoremoveUnused": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Autoremove unused dependencies" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Удалить неиспользуемые зависимости" } }
      }
    },
    "settings.brew.confirmDestructive": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Confirm before uninstall / zap" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Подтверждать uninstall и zap" } }
      }
    },
    "settings.brew.confirmDestructive.help": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Destructive actions (Uninstall, Zap, Delete Brewfile) ask before proceeding." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Разрушительные действия (Uninstall, Zap, удаление Brewfile) требуют подтверждения." } }
      }
    },
    "settings.brew.confirmations": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Confirmations" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Подтверждения" } }
      }
    },
    "settings.brew.greedyUpgrades": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Greedy upgrades (include self-updating casks)" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Greedy-обновления (включая самообновляемые cask-пакеты)" } }
      }
    },
    "settings.brew.greedyUpgrades.help": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Adds `--greedy` to `brew upgrade` so casks that update themselves (like Chrome) are upgraded too. Off by default — greedy can churn apps that manage their own updates." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Добавляет `--greedy` к `brew upgrade`, чтобы обновлять и cask-пакеты, которые обычно обновляются сами (например, Chrome). По умолчанию выключено: greedy может лишний раз трогать приложения с собственным обновлением." } }
      }
    },
    "settings.brew.sendAnalytics": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Send Homebrew install analytics" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Отправлять аналитику установок Homebrew" } }
      }
    },
    "settings.fileUnreadable": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Settings file is unreadable." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Файл настроек не читается." } }
      }
    },
    "settings.github.showStats": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Show GitHub stats on package pages" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Показывать статистику GitHub на страницах пакетов" } }
      }
    },
    "settings.github.showStats.help": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Show repo stars, forks, and last release for any package whose homepage is a GitHub URL. Fetches public metadata from api.github.com." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Показывает звёзды, форки и последний релиз репозитория для пакетов, у которых homepage ведёт на GitHub. Загружает публичные метаданные с api.github.com." } }
      }
    },
    "settings.network.caskIconFetching": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Cask icon fetching" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Загрузка иконок cask-пакетов" } }
      }
    },
    "settings.network.catalogAutoRefresh": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Catalog auto-refresh" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Автообновление каталога" } }
      }
    },
    "settings.network.catalogStaleThreshold.format": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Catalog stale-banner threshold: %d days" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Порог баннера устаревшего каталога: %d дн." } }
      }
    },
    "settings.network.offlineMode": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Offline Mode" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Офлайн-режим" } }
      }
    },
    "settings.network.offlineMode.help": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Blocks every outbound network call: catalog refresh, Trending, GitHub stats + sign-in, cask icon probes, update checks. brew itself still runs normally. UI that needs the network shows a disabled by Offline Mode notice." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Блокирует все исходящие сетевые вызовы: обновление каталога, Тренды, статистику и вход GitHub, запросы иконок cask-пакетов и проверки обновлений. Сам brew продолжает работать как обычно. Интерфейс, которому нужна сеть, показывает уведомление об отключении офлайн-режимом." } }
      }
    },
    "settings.network.offlineMode.on": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Offline Mode is on — Trending, Catalog refresh, and Cask icon probes are blocked." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Офлайн-режим включён: Тренды, обновление каталога и запросы иконок cask-пакетов заблокированы." } }
      }
    },
    "settings.network.trendingTtl.format": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Trending cache TTL: %d min" } },
        "ru": { "stringUnit": { "state": "translated", "value": "TTL кэша трендов: %d мин" } }
      }
    },
    "settings.offlineToggleLocked": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Offline Mode is on — this toggle is locked off." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Офлайн-режим включён: этот переключатель заблокирован." } }
      }
