        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "brew-browser хранит токен в {keyringName}. Токен никогда не отправляется в renderer-процесс по IPC, никогда не записывается на диск и никогда не попадает в логи. Через IPC передаётся только производное представление "
          }
        }
      }
    },
