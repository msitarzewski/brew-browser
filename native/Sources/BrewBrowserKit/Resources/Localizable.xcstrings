      }
    },
    "services.status.stopped": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "stopped" } },
        "ru": { "stringUnit": { "state": "translated", "value": "остановлена" } }
      }
    },
    "services.status.unknown": {
      "localizations": {
