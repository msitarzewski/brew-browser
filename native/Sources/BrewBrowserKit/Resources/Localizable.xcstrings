        "ru": { "stringUnit": { "state": "translated", "value": "Устаревших пакетов нет." } }
      }
    },
    "upgrade.pinned.help": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Pinned packages are not upgraded by brew. Unpin with `brew unpin <name>`." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Закреплённые пакеты не обновляются brew. Снимите закрепление командой `brew unpin <name>`." } }
